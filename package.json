{
  "name": "mrowl-dungeon",
  "version": "1.0.0",
  "description": "Mr Owl's Dungeon Adventure - Learn Polish while exploring!",
  "main": "index.js",
  "scripts": {
    "build": "esbuild www/js/lib/maze-bundle.js --bundle --format=iife --global-name=MazeGenerator --outfile=www/js/lib/maze.js",
    "test": "node tests/run-tests.js",
    "start": "open index.html",
    "web:build": "echo 'www/ is the source directory, no build needed'",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap copy android && npx cap run android",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap copy ios && npx cap run ios",
    "test:cem": "node tools/smoke/cemetery.js",
    "test:cem:perf": "node tools/smoke/cem-perf.js",
    "test:fp:perf": "node tools/smoke/fp-perf.js",
    "test:card": "node tools/smoke/card.js",
    "record:cem": "node tools/smoke/cem-record.js",
    "record:classic": "node tools/smoke/dungeon-record.js --view classic",
    "record:iso": "node tools/smoke/dungeon-record.js --view iso",
    "record:fp": "node tools/smoke/fp-record.js --mode explore --seconds 60",
    "record:fp:dragon": "node tools/smoke/fp-record.js --mode dragon",
    "test:e2e": "maestro test .maestro/flows/",
    "test:e2e:android": "maestro test .maestro/flows/",
    "test:e2e:ios": "maestro test .maestro/flows/ --platform ios",
    "test:e2e:record": "maestro record .maestro/flows/03-complete-game-automated.yaml",
    "vendor:three": "esbuild www/js/lib/three-entry.js --bundle --format=iife --global-name=THREE --target=es2017 --minify --legal-comments=none --outfile=www/js/lib/three.bundle.js",
    "vendor:phaser": "esbuild node_modules/phaser/dist/phaser.js --minify --target=es2017 --legal-comments=inline --outfile=www/js/lib/phaser.min.js",
    "vendor": "npm run vendor:three && npm run vendor:phaser",
    "proto": "python3 -m http.server 8080 -d www"
  },
  "keywords": [
    "game",
    "education",
    "polish",
    "language-learning"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.0",
    "@capacitor/android": "^8.0.1",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/preferences": "^8.0.0",
    "generate-maze": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "phaser": "^3.90.0",
    "puppeteer-core": "^25.11.0",
    "three": "^0.162.0"
  }
}
